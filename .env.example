# AWS S3 Configuration
# These are used by upload_s3.sh and can also be set via AWS CLI (aws configure)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# S3 bucket for ASOS data (without s3:// prefix)
S3_BUCKET=your-bucket-name

# S3 prefix within the bucket (default: asos)
S3_PREFIX=asos

# Optional: Cloudflare R2 (legacy, if still needed)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
