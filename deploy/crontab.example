# ASOS Parquet - Crontab Configuration
#
# Install with: crontab deploy/crontab.example
# Or add these lines to existing crontab: crontab -e
#
# Assumes:
#   - Project installed at /opt/asos-parquet
#   - .env configured with S3_BUCKET and AWS credentials
#   - uv installed and in PATH

# Environment setup
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin:/home/deploy/.local/bin
MAILTO=""

# Update ASOS data hourly (at minute 5, to avoid exact hour congestion)
# Fetches last 2 hours of observations, merges, and uploads current year to S3
5 * * * * cd /opt/asos-parquet && ./scripts/cron-update.sh >> /var/log/asos-update.log 2>&1

# Optional: More frequent updates (every 30 minutes)
# 5,35 * * * * cd /opt/asos-parquet && ./scripts/cron-update.sh >> /var/log/asos-update.log 2>&1

# Optional: Daily full sync of all years (in case of any drift)
# Runs at 3:00 AM UTC
# 0 3 * * * cd /opt/asos-parquet && ./scripts/upload_s3.sh >> /var/log/asos-sync.log 2>&1

# Optional: Weekly log rotation
# 0 0 * * 0 find /var/log -name "asos-*.log" -mtime +30 -delete
